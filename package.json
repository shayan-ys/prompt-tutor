{
  "name": "prompt-tutor",
  "version": "0.1.0",
  "description": "Out-of-band English reviews for omp prompts, with a terminal Watcher and weekly Digest.",
  "license": "MIT",
  "type": "module",
  "bin": {
    "prompt-tutor": "bin/prompt-tutor"
  },
  "omp": {
    "extensions": ["./src/omp/index.ts"]
  },
  "scripts": {
    "typecheck": "bunx tsc --noEmit",
    "lint": "bunx biome check .",
    "test": "bun test",
    "check": "bunx tsc --noEmit && bunx biome check . && bun test"
  },
  "peerDependencies": {
    "@oh-my-pi/pi-ai": "^18.8.5",
    "@oh-my-pi/pi-coding-agent": "^18.8.5"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.2.0",
    "@oh-my-pi/pi-ai": "18.8.5",
    "@oh-my-pi/pi-coding-agent": "18.8.5",
    "@types/bun": "^1.3.0",
    "typescript": "^5.9.0"
  }
}
